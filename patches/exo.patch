From 54a3fe9f9a632eabd9546f28f1afb4a1612d3b73 Mon Sep 17 00:00:00 2001
From: Yongha Hwang <mshrimp@sogang.ac.kr>
Date: Thu, 12 Oct 2023 01:13:09 +0000
Subject: [PATCH] exo-open: (Issue #108) Relaxed URI check

Only check if a URI scheme is valid, as some URI schemes may not follow RFC 3986.
---
 exo-open/main.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/exo-open/main.c b/exo-open/main.c
index 5af63e8..db0ea53 100644
--- a/exo-open/main.c
+++ b/exo-open/main.c
@@ -50,9 +50,11 @@
 #define PATHTERM_CLASS  "[^\\Q]'.}>) \t\r\n,\"\\E]"
 #define USERPASS        USERCHARS_CLASS "+(?:" PASSCHARS_CLASS "+)?"
 #define URLPATH         "(?:(/"PATHCHARS_CLASS"+(?:[(]"PATHCHARS_CLASS"*[)])*"PATHCHARS_CLASS"*)*"PATHTERM_CLASS")?"
+#define SCHEME          "[[:alpha:]][[:alnum:]+-.]*"
 
 #define MATCH_PATTERN_HTTP      "(?:www|ftp)" HOSTCHARS_CLASS "*\\." HOST PORT URLPATH
 #define MATCH_PATTERN_EMAIL     "(?:mailto:)?" USERCHARS_CLASS "[" USERCHARS ".]*\\@" HOSTCHARS_CLASS "+\\." HOST
+#define MATCH_PATTERN_URI       SCHEME "://.*"
 
 
 
@@ -696,6 +698,12 @@ main (gint argc, gchar **argv)
               /* use the argument directly */
               uri = g_strdup (*argv);
             }
+          /* also allow uri-like string: issue exo#108 */
+          else if (g_regex_match_simple(MATCH_PATTERN_URI, *argv, G_REGEX_CASELESS, 0))
+            {
+              /* use the argument directly */
+              uri = g_strdup (*argv);
+            }
           else
             {
               /* try to build a valid uri */
