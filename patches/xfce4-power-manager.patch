 static void
+xfpm_button_ungrab (XfpmButton *button, guint keysym, XfpmButtonKey key)
+{
+  Display *display;
+  GdkDisplay *gdisplay;
+  guint modmask = AnyModifier;
+  guint keycode = XKeysymToKeycode (gdk_x11_get_default_xdisplay(), keysym);
+
